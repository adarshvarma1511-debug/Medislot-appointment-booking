# ==============================================================================
# MediSlot Environment Variables Template
# Copy this file to .env.local and update with your credentials
# ==============================================================================

# Database Connection
# --------------------
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/medislot

# Or MongoDB Atlas (Cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/medislot?retryWrites=true&w=majority

# Google OAuth Authentication (Optional)
# ---------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8443/api/auth/google/callback
